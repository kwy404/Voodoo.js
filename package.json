{
  "name": "voodoo-monorepo",
  "version": "0.7.0",
  "private": true,
  "description": "The Voodoo.js monorepo: the library, its command line and the website.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=voodoojs && npm run build --workspace=voodoojs-cli",
    "dev": "npm run dev --workspace=voodoojs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build --workspace=voodoojs && playwright test",
    "test:browser:only": "playwright test",
    "test:browser:install": "playwright install chromium",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p packages/voodoojs/tsconfig.json --noEmit",
    "typecheck:browser": "tsc -p packages/voodoojs/test/browser/tsconfig.json --noEmit",
    "format": "prettier --write \"**/*.{ts,js,json,md,html,css}\"",
    "size": "node scripts/size.mjs",
    "serve": "node scripts/serve.mjs",
    "docs:index": "node scripts/docs-index.mjs",
    "quality": "node scripts/quality.mjs",
    "quality:ci": "node scripts/quality.mjs --ci --report",
    "quality:report": "node scripts/quality.mjs --report",
    "api:snapshot": "node scripts/api-snapshot.mjs --update",
    "check:links": "node scripts/check-links.mjs",
    "check:lang:docs": "node scripts/check-docs-language.mjs --check",
    "check:lang:src": "node scripts/check-source-language.mjs --check",
    "check:lang": "npm run check:lang:docs && npm run check:lang:src",
    "check:version": "node scripts/stamp-version.mjs --check",
    "check:frame": "node scripts/check-frame-height.mjs",
    "conformance": "node scripts/conformance.mjs",
    "check:conformance": "node scripts/conformance.mjs --check",
    "release": "node scripts/release.mjs",
    "check:packaging": "node scripts/check-packaging.mjs",
    "check:site": "node scripts/check-site-bundles.mjs",
    "check:i18n": "node scripts/check-site-i18n.mjs",
    "test:seasons": "node --test scripts/seasons.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^2.1.8",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.13.0"
}
