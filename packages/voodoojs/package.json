{
  "name": "voodoojs",
  "version": "0.3.0",
  "description": "Voodoo.js: o framework JavaScript HTML-first. Construa aplicacoes reativas direto no HTML: reatividade granular, componentes, HTTP, formularios, validacao, roteador e UI. Sem build obrigatorio, sem dependencias, sem Virtual DOM, sem eval. JavaScript feels like magic.",
  "keywords": [
    "javascript",
    "framework",
    "html-first-framework",
    "reactive-framework",
    "vanilla",
    "html-first",
    "reactivity",
    "signals",
    "directives",
    "alpine",
    "htmx",
    "jquery",
    "petite-vue",
    "no-build",
    "cdn",
    "ajax",
    "forms",
    "validation",
    "toast",
    "modal",
    "spa",
    "hypermedia"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/essential.ts",
    "./src/core.ts",
    "./src/browser.ts",
    "./src/browser-essential.ts",
    "./src/bootstrap.ts",
    "./src/directives/*.ts",
    "./src/motion/*.ts",
    "./src/charts/*.ts",
    "./src/ui/components.ts",
    "./src/router/*.ts",
    "./src/i18n/*.ts",
    "./src/runtime/magics.ts",
    "./dist/index.js",
    "./dist/index.cjs",
    "./dist/essential.js",
    "./dist/essential.cjs",
    "./dist/gpu.js",
    "./dist/gpu.cjs",
    "./dist/socket.js",
    "./dist/socket.cjs",
    "./dist/voodoo.js",
    "./dist/voodoo.min.js",
    "./dist/voodoo.core.js",
    "./dist/voodoo.core.min.js",
    "./dist/voodoo.full.js",
    "./dist/voodoo.full.min.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/voodoo.min.js",
  "jsdelivr": "./dist/voodoo.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./essential": {
      "types": "./dist/essential.d.ts",
      "import": "./dist/essential.js",
      "require": "./dist/essential.cjs"
    },
    "./reactivity": {
      "types": "./dist/reactivity.d.ts",
      "import": "./dist/reactivity.js",
      "require": "./dist/reactivity.cjs"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js",
      "require": "./dist/http.cjs"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    },
    "./gpu": {
      "types": "./dist/gpu.d.ts",
      "import": "./dist/gpu.js",
      "require": "./dist/gpu.cjs"
    },
    "./socket": {
      "types": "./dist/socket.d.ts",
      "import": "./dist/socket.js",
      "require": "./dist/socket.cjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwy404/Voodoo.js.git",
    "directory": "packages/voodoojs"
  },
  "homepage": "https://voodoojs.dev",
  "bugs": {
    "url": "https://github.com/kwy404/Voodoo.js/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
